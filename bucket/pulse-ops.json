{
    "version": "0.1.0",
    "description": "PULSE / OPS: server, DB, Redis and HTTP observability dashboard with alerts (single binary + SQLite)",
    "homepage": "https://github.com/qmdch1/pulse-ops",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/qmdch1/pulse-ops/releases/download/v0.1.0/pulse-ops_0.1.0_windows_amd64.zip",
            "hash": "b94be8177d6924e169aef3f00f44c220cdb9cedc61cb8f52c7497f24fcf3e609"
        }
    },
    "bin": "pulse-ops.exe",
    "persist": "data",
    "env_set": {
        "CONTROL_DATA_DIR": "$persist_dir\\data"
    },
    "notes": [
        "Listens on http://127.0.0.1:7080 by default (CONTROL_LISTEN).",
        "Production mode needs CONTROL_MASTER_KEY, DASHBOARD_USERNAME, DASHBOARD_PASSWORD (24+ chars) and CONTROL_ALLOWED_ORIGINS.",
        "For a quick local trial without login: set MONITORING_MODE=test (loopback listener only).",
        "See https://github.com/qmdch1/pulse-ops/blob/main/docs/setup.md"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qmdch1/pulse-ops/releases/download/v$version/pulse-ops_$version_windows_amd64.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "$sha256\\s+$basename"
                }
            }
        }
    }
}
